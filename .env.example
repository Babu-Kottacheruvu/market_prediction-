# Copy to .env and fill in.  NEVER commit .env (real values live in .env only).
DATABASE_URL=
DATA_PROVIDER=          # leave empty: config/markets.yaml routes markets (mt5)
API_KEY=
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# MetaTrader 5 (the single market-data source; terminal must be installed)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=5056625794
MT5_PASSWORD=Zr@zU7Qq
MT5_SERVER=MetaQuotes-Demo
MT5_REFRESH=1           # auto-refresh stored candles from MT5 when stale
MT5_STALE_CANDLES=3
MT5_MAX_BARS=100000     # total fallback bars, fetched in batches of at most 10000

# Legacy / optional alternatives (not used while provider is mt5)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_BASE_URL=https://api.binance.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
